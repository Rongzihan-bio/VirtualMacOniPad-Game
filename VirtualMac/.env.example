# Copy to .env and fill only values needed by the command being run. The
# root setup.sh wizard normally makes this file unnecessary. .env is ignored.

VZ_BUILD_ROOT=
VZ_DOWNLOAD_ROOT=
VZ_MACOS_IPSW=
VZ_IPADOS_IPSW=
VZ_DEVICE_SUPPORT_DMG=
VZ_XCODE_PATH=

# Optional matching-Mac oracle configuration (not used by setup.sh).
VZ_REAL_MAC_HOST=
VZ_REAL_MAC_PORT=22
VZ_REAL_MAC_USER=
VZ_REAL_MAC_PASSWORD=

# Optional USB deployment configuration.
VZ_IPAD_UDID=
VZ_IPAD_PORT=2221
VZ_IPAD_PASSWORD=

# Optional guest diagnostic configuration.
VZ_GUEST_HOST=
VZ_GUEST_USER=
VZ_GUEST_PASSWORD=
