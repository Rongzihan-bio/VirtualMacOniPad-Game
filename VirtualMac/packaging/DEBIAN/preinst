#!/bin/sh

set -eu
export PATH=/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin

# Prepare ElleKit's canonical loader directory for postinst. Some bootstrap
# revisions omit it, while their MobileSubstrate compatibility path may be a
# dangling symlink. The tweak is copied here only after dpkg has cleaned paths
# owned by 1.0, avoiding an upgrade-time alias collision.
mkdir -p /var/jb/usr/lib/TweakInject

# Some iPadOS 16 builds leave /var/root at 0750. Virtual Mac itself runs as
# mobile and must traverse this directory to execute its root-owned setuid
# restore launcher. Add traverse permission only; this does not permit mobile
# to list /var/root. Preserve every existing owner/group permission bit.
if test -d /var/root && ! su mobile -c 'test -x /var/root' 2>/dev/null; then
    chmod o+x /var/root
fi

killall VirtualMac 2>/dev/null || true
killall com.apple.Virtualization.VirtualMachine 2>/dev/null || true
killall com.apple.Virtualization.Installation 2>/dev/null || true
killall install-macos 2>/dev/null || true

rm -f /tmp/vmm.stderr.log /tmp/restore-vmm.stderr.log
rm -f /tmp/vmm_ep.txt.* /tmp/installation_ep.txt.*

if test -d /var/jb/Applications/VirtualMac.rootless-backup; then
    rm -rf /var/jb/Applications/VirtualMac.rootless-backup
fi
exit 0
