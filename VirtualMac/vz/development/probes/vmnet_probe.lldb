settings set auto-confirm true
settings set target.process.stop-on-sharedlibrary-events false
target create /var/jb/usr/local/bin/vmnet-probe
run
register read x0 x1 x2 x15 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 fp lr sp pc
memory read --format s --count 1 '$sp+0x10'
bt all
image list -o -f
disassemble --frame --mixed
quit
