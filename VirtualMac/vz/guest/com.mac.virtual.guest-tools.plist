<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac.virtual.guest-tools</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/VirtualMac/Virtual Mac Guest Tools.app/Contents/MacOS/Virtual Mac Guest Tools</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/VirtualMacGuestTools.stderr.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/VirtualMacGuestTools.stdout.log</string>
</dict>
</plist>
